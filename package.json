{
  "name": "react-style-props",
  "version": "1.1.4",
  "description": "React library for styling components with defined props",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs",
    "build:docs": "vite build",
    "prepare": "npm run build",
    "dev": "vite",
    "preview": "vite preview"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "style",
    "css",
    "typescript",
    "javascript",
    "props",
    "styling",
    "css-in-js",
    "props"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yeonpm/react-style-props.git"
  },
  "homepage": "https://react-style-props.vercel.app",
  "bugs": {
    "url": "https://github.com/yeonpm/react-style-props/issues"
  },
  "author": {
    "name": "yeonpm",
    "email": "yeonpmdevelop@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@babel/preset-env": "7.26.0",
    "@babel/preset-react": "7.25.9",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@rollup/plugin-alias": "5.1.1",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-commonjs": "28.0.1",
    "@rollup/plugin-node-resolve": "15.3.0",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.1.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "4.2.0",
    "@yeonpm/docs-template": "0.4.6",
    "@yeonpm/react": "1.1.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "5.6.0",
    "rollup-plugin-dts": "6.1.1",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "tslib": "2.8.1",
    "typescript": "5.4.5",
    "vite": "5.4.11",
    "zustand": "4.5.4"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
